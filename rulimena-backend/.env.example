# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rulimena
DB_PORT=3306

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Application Configuration
APP_NAME=rulimena-backend

# SIP Configuration
ASTERISK_AMI_HOST=localhost
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=rulimena
ASTERISK_AMI_PASSWORD=rulimena_password

SIP_SERVER=sip.rulimena.io
SIP_PORT=5060
SIP_TRANSPORT=udp
SIP_USERNAME=rulimena
SIP_PASSWORD=rulimena_sip_password
SIP_REALM=rulimena.io
SIP_REGISTER=true
SIP_REGISTER_EXPIRES=3600
SIP_CODECS=PCMU,PCMA,G729
SIP_LOCAL_ADDRESS=0.0.0.0
SIP_PUBLIC_ADDRESS=
SIP_NAT=false
SIP_FIREWALL=false
SIP_DTMF_MODE=rfc2833
SIP_USE_SRTP=false
SIP_RTP_PORT_RANGE=10000-20000

DIALER_MAX_CONCURRENT_CALLS=5
DIALER_CALL_TIMEOUT=30
DIALER_RING_TIMEOUT=20
DIALER_MAX_RETRIES=3
DIALER_RETRY_INTERVAL=5
PREDICTIVE_MAX_RINGS=10
PREDICTIVE_RING_DELAY=2
PREDICTIVE_MAX_CONCURRENT=5